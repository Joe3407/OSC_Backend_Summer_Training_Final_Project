# ==========================
# 1. Dependencies (The biggest junk folder)
# ==========================
node_modules/
jspm_packages/

# ==========================
# 2. Compiled JavaScript (SAFETY NET!)
# ==========================
# Ignores accidental .js files generated by 'tsc'
*.js
# But keeps important config files just in case
!jest.config.js 

# ==========================
# 3. TypeScript Build Output
# ==========================
dist/
build/
out-tsc/
*.tsbuildinfo

# ==========================
# 4. Logs & Errors
# ==========================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================
# 5. Editor & OS Junk
# ==========================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================
# 6. Environment Variables
# ==========================
.env
.env.local